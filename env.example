# Copy this file to ".env" and fill in your real key, OR set these directly
# in your shell / hosting dashboard. Never commit a real key to source control.

# Required: your Financial Modeling Prep API key.
FMP_API_KEY=put-your-fmp-key-here

# Optional: transport. "stdio" for Claude Desktop (local), "http" for a hosted
# remote URL used by claude.ai web/mobile. Defaults to stdio.
# FMP_MCP_TRANSPORT=stdio

# Optional: host/port for the hosted transport only.
# FMP_MCP_HOST=0.0.0.0
# FMP_MCP_PORT=8787
