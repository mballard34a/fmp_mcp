# Financial Modeling Prep credential. Keep the real value private.
FMP_API_KEY=your-fmp-api-key

# Long random bearer token used by the local Codex plugin.
FMP_MCP_ACCESS_TOKEN=your-long-random-access-token

# Accept both the private Codex token and Auth0 OAuth access tokens.
FMP_MCP_AUTH_MODE=mixed

# Public Render service address, without /mcp or a trailing slash.
MCP_PUBLIC_BASE_URL=https://bcna-fmp-mcp.onrender.com

# Exact Auth0 issuer. Auth0 issuers normally end with a slash.
OAUTH_ISSUER=https://your-tenant.us.auth0.com/

# Must exactly match the Identifier configured for the Auth0 API.
OAUTH_AUDIENCE=https://bcna-fmp-mcp.onrender.com

# Scope that Auth0 must include in the access token.
OAUTH_REQUIRED_SCOPES=fmp:read
OAUTH_ALGORITHMS=RS256

# Optional override. Normally leave blank so it is derived from OAUTH_ISSUER.
OAUTH_JWKS_URL=
